# Easiest: run setup.ps1 (Windows) or ./setup.sh (Linux/macOS/NAS) once. It writes a .env
# with strong random DB_PASSWORD / JWT_SECRET and starts the stack. There are no defaults:
# the stack refuses to start without both.
# By hand: copy this file to .env and replace both values with long random strings
# BEFORE the first start (the database keeps the password it was created with).
DB_PASSWORD=change_this_database_password
JWT_SECRET=change_this_long_random_secret

# ── Backups (optional) ────────────────────────────────────────
# Backups are always on. Empty BACKUP_PATH = the app's own backups/ folder. A disk that
# fails takes its backups with it, so prefer another drive (app on C:, backups on D:).
#   Windows:  BACKUP_PATH=D:\bethesda-backups
#   NAS:      BACKUP_PATH=/volume2/bethesda-backups
BACKUP_PATH=
BACKUP_RETENTION_DAYS=30
BACKUP_TIME=02:00
TZ=Indian/Antananarivo

# ── Updates (optional) ────────────────────────────────────────
# Where the update check reads latest.json. Default: the newest GitHub Release.
#UPDATE_LATEST_URL=
#UPDATE_CHECK=false
